# ============================================================
# Social Lab 应用配置
# ============================================================

APP_NAME=Social Lab Agent API
APP_VERSION=0.2.0
APP_DESCRIPTION=Social Lab 后端 Agent 稳定服务层 API

# development / test / staging / production
APP_ENV=development

# ============================================================
# 日志配置
# ============================================================

# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# ============================================================
# Debug 接口
# ============================================================

# 开发环境可设为 true
# 生产环境必须设为 false
DEBUG_ENDPOINTS_ENABLED=true

# ============================================================
# CORS 配置
# ============================================================

# 多个 Origin 使用英文逗号分隔
# 不要写路径，例如不要写 https://xihe159.github.io/social-lab
# Origin 只需要协议、域名和端口
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://xihe159.github.io

CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ============================================================
# LLM 配置
# ============================================================

LLM_API_KEY=your_api_key

# OpenAI 官方接口可以留空
# OpenAI 兼容接口填写对应地址
LLM_BASE_URL=https://your-openai-compatible-base-url

LLM_MODEL_ID=your_model_id

# 单次模型请求最大等待时间，单位为秒
LLM_TIMEOUT_SECONDS=60

# SDK 自动重试次数
LLM_MAX_RETRIES=1

# ============================================================
# Agent 配置
# ============================================================

# v1 / v2
SIMULATION_AGENT_VERSION=v1
# V2.1 质量验证阶段可显式设置为 v2.1；默认仍保持 v1 便于快速回退。

EVALUATION_EXECUTION_MODE=development_sync
